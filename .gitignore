# =============================================================================
# OrgOS — .gitignore
# =============================================================================

# CRITICAL — these files contain real credentials, NEVER commit them
.env
frontend/.env.local
**/docs.local/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
orgos_env/
venv/
env/
.venv/
*.egg-info/
dist/
build/
.eggs/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editors
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs
*.log
logs/

# Runtime checkpoint files — generated by scripts, never commit
scripts/intake_lifecycle_checkpoint.json
scripts/bulk_extract_checkpoint.json
scripts/intake_lifecycle.lock

# OS
Thumbs.db

# Kortex — auto-generated context file
.kortex/

# Local pre-purge list exports
backups/

# CDI library census output (scripts/cdi_library_census.py)
census.json
census.txt
.cdi_corpus/

# Internal source documents kept on disk but never committed (CDI family, governance review package,
# Records Catalogue). Copy them to the server by hand; scripts read them from docs/.
docs/*.xlsx
docs/*.pdf
docs/Control of Documented Information *.docx
docs/CDI and Records Forms and Templates Set.docx
docs/Dragnet20Governance*/
docs/Dragnet Job Descriptions*.zip
