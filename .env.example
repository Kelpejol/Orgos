# =============================================================================
# OrgOS — Backend Environment Variables
# cp .env.example .env  →  fill in every [REQUIRED] value  →  never commit .env
# =============================================================================

# Entra ID — the SHARED Dragnet ERP app registration (OrgOS has no login of
# its own; get these three from the ERP team, not a dedicated OrgOS app reg)
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# Shared secret the ERP calls POST /api/auth/revoke with when a user's
# org_roles change. Obtain from the ERP team. Empty = revocation disabled.
REVOKE_SECRET=
AI_REVIEW_QUEUE_LIST_ID=your-ai-review-queue-list-id-here
DOCUMENT_LIFECYCLE_LIST_ID=your-document-lifecycle-list-id-here
CONTROL_REGISTER_LIST_ID=your-control-register-list-id-here
EVIDENCE_TRACKER_LIST_ID=your-evidence-tracker-list-id-here
AUDIT_LOG_LIST_ID=your-audit-log-list-id-here
STRATEGIC_RISK_REGISTER_LIST_ID=your-strategic-risk-register-list-id-here
GAP_ANALYSIS_LIST_ID=your-gap-analysis-list-id-here
# Records Catalogue: Title = Record ID, RecordName (single line), Payload (multiple lines, plain text)
RECORDS_CATALOGUE_LIST_ID=your-records-catalogue-list-id-here
PROCEDURAL_STEPS_LIST_ID=your-procedural-steps-list-id-here
# SharePoint — GET https://graph.microsoft.com/v1.0/sites/dragnet.sharepoint.com:/sites/orgos
SHAREPOINT_SITE_ID=your-site-id-here
SHAREPOINT_SITE_URL=https://dragnetnigeria.sharepoint.com/sites/orgos
COMPLIANCE_SITE_URL=https://dragnetnigeria.sharepoint.com/sites/everybody
# Previous library: ORGOS LIBRARY
# SharePoint URL label: GRC MASTERY LIBRARY; Graph drive name: GRC CONTROL LIBRARY
COMPLIANCE_LIBRARY_NAME=ORGOS LIBRARY
COMPLIANCE_STARTING_FOLDER=ORGOS CONTROL LIBRARY
COMPLIANCE_INTAKE_FOLDERS=

# SharePoint List IDs — leave as "placeholder" until lists are created in SharePoint
DOCUMENT_REGISTER_LIST_ID=placeholder
COMPLIANCE_CALENDAR_LIST_ID=placeholder
CONTRACT_REGISTER_LIST_ID=placeholder
GRAPH_SEARCH_REGION=EUR

# Where ChromaDB stores the vector index on disk
CHROMA_PERSIST_DIR=./chroma_db


# App
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173
APP_PORT=8000
LOG_LEVEL=DEBUG
SKIP_AUTH=false

# May the app write edits back to the SharePoint documents (CDI fixes,
# amendments, attaching a CDT cover)? In dev the edit is still made and shown
# in full, it is just never uploaded. Unset = dev while ENVIRONMENT=development.
DOCUMENT_WRITE_MODE=dev

# Do the CDI checks (V01–V24) stop a document at Lifecycle? off | advisory | enforce.
# advisory (default): shown and stored on the card, never blocking. enforce: a blocking
# problem — including a role that is not in Org Roles — stops Progress and approval.
STANDARD_GATE=advisory

# Who owns the Lifecycle items the SharePoint intake opens (when --owner-email isn't given).
INTAKE_OWNER_EMAIL=

# ORGOS LIBRARY folder holding one CDT master template per document type.
CDT_TEMPLATES_FOLDER=Templates

# Where OrgOS is reached from a browser. Used to build the ReadDocumentUrl that
# Power Automate puts in Teams notifications, so reviewers open a read-only PDF
# instead of the editable Word file. Defaults to the first ALLOWED_ORIGINS entry.
APP_BASE_URL=http://localhost:5173

# OpenTelemetry / Grafana observability
# DevOps can enable traces, metrics, and logs with this one OTLP/HTTP endpoint.
# Grafana Alloy local example: http://grafana-alloy:4318
# Grafana Cloud also needs OTEL_EXPORTER_OTLP_HEADERS with its auth header.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=orgos-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_METRICS_INTERVAL_MS=60000


# Which inference service the AI features use: ollama | runpod
LLM_PROVIDER=ollama

# Ollama — used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# RunPod serverless — used when LLM_PROVIDER=runpod
RUNPOD_API_KEY=
RUNPOD_LIGHT_ENDPOINT_ID=
RUNPOD_HEAVY_ENDPOINT_ID=
RUNPOD_EMBED_ENDPOINT_ID=
RUNPOD_TIMEOUT=120


# Azure Document Intelligence — OCR fallback for scanned PDFs and DOCXs
# Leave blank to disable OCR fallback (native extraction only)
# Endpoint format: https://<resource-name>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=



INFERENCE_API_KEY=
EMBED_API_URL=https://gpu.idhub.ng/embed
CHAT_API_URL=https://gpu.idhub.ng/chat
