# OrgOS Frontend Environment Variables
# cp .env.local.example .env.local  →  fill in values  →  never commit .env.local

# FastAPI backend URL (this app's own backend)
VITE_API_BASE_URL=http://localhost:8000

# Dragnet ERP shell URL — unauthenticated visitors are redirected here to
# sign in; the shell sets the erp_auth cookie and bounces back. No MSAL
# config needed here — OrgOS never talks to Azure AD directly.
VITE_ERP_URL=http://localhost:5173
